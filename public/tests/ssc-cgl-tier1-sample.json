    {
      "id": "cgl-q4",
      "subject": "Quantitative Aptitude",
      "topic": "Percentage",
      "difficulty": "Easy",
      "question": {
        "en": "A number is increased by 20% and then decreased by 20%. What is the net percentage change?",
        "hi": "किसी संख्या में 20% वृद्धि और फिर 20% कमी की जाती है। कुल प्रतिशत परिवर्तन क्या होगा?"
      },
      "options": [
        { "id": "A", "text": { "en": "No change", "hi": "कोई परिवर्तन नहीं" } },
        { "id": "B", "text": { "en": "4% decrease", "hi": "4% कमी" } },
        { "id": "C", "text": { "en": "4% increase", "hi": "4% वृद्धि" } },
        { "id": "D", "text": { "en": "2% decrease", "hi": "2% कमी" } }
      ],
      "correctOptionId": "B",
      "explanation": {
        "en": "Net change is $x + y + \\frac{xy}{100} = 20 - 20 - 4 = -4\\%$.",
        "hi": "कुल परिवर्तन $x + y + \\frac{xy}{100} = 20 - 20 - 4 = -4\\%$ है।"
      }
    },
    {
      "id": "cgl-q5",
      "subject": "Quantitative Aptitude",
      "topic": "Algebra",
      "difficulty": "Moderate",
      "question": {
        "en": "If $x + \\frac{1}{x} = 5$, find $x^2 + \\frac{1}{x^2}$.",
        "hi": "यदि $x + \\frac{1}{x} = 5$ है, तो $x^2 + \\frac{1}{x^2}$ ज्ञात करें।"
      },
      "options": [
        { "id": "A", "text": { "en": "21", "hi": "21" } },
        { "id": "B", "text": { "en": "23", "hi": "23" } },
        { "id": "C", "text": { "en": "25", "hi": "25" } },
        { "id": "D", "text": { "en": "27", "hi": "27" } }
      ],
      "correctOptionId": "B",
      "explanation": {
        "en": "Squaring gives $x^2 + 2 + \\frac{1}{x^2} = 25$, so the answer is 23.",
        "hi": "वर्ग करने पर $x^2 + 2 + \\frac{1}{x^2} = 25$, अतः उत्तर 23 है।"
      }
    },
    {
      "id": "cgl-q6",
      "subject": "Quantitative Aptitude",
      "topic": "Time and Work",
      "difficulty": "Hard",
      "question": {
        "en": "A can finish a work in 12 days and B in 18 days. Working together, how many days will they take?",
        "hi": "A किसी कार्य को 12 दिनों में और B 18 दिनों में पूरा कर सकता है। साथ मिलकर वे कितने दिनों में कार्य पूरा करेंगे?"
      },
      "options": [
        { "id": "A", "text": { "en": "$7\\frac{1}{5}$ days", "hi": "$7\\frac{1}{5}$ दिन" } },
        { "id": "B", "text": { "en": "$7\\frac{2}{5}$ days", "hi": "$7\\frac{2}{5}$ दिन" } },
        { "id": "C", "text": { "en": "8 days", "hi": "8 दिन" } },
        { "id": "D", "text": { "en": "9 days", "hi": "9 दिन" } }
      ],
      "correctOptionId": "A",
      "explanation": {
        "en": "Combined rate is $\\frac{1}{12}+\\frac{1}{18}=\\frac{5}{36}$, so time is $\\frac{36}{5}=7\\frac{1}{5}$ days.",
        "hi": "संयुक्त दर $\\frac{1}{12}+\\frac{1}{18}=\\frac{5}{36}$ है, अतः समय $\\frac{36}{5}=7\\frac{1}{5}$ दिन है।"
      }
    },
